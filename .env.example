# Smart Resume Screener Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./database/resume_screener.db

# LLM Provider Configuration
# Supported providers: gemini, openai, auto
LLM_PROVIDER=auto

# Google Gemini API Key (Required for Gemini model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Screening Defaults
DEFAULT_SHORTLIST_THRESHOLD=7.0
MAX_UPLOAD_SIZE_MB=10
